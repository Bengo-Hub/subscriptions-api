# Subscription Service Configuration

# Application
SUBSCRIPTION_APP_NAME=subscription-service
SUBSCRIPTION_APP_ENV=development
SUBSCRIPTION_APP_VERSION=0.1.0

# HTTP Server
SUBSCRIPTION_HTTP_HOST=0.0.0.0
SUBSCRIPTION_HTTP_PORT=4005
SUBSCRIPTION_HTTP_READ_TIMEOUT=15s
SUBSCRIPTION_HTTP_WRITE_TIMEOUT=15s
SUBSCRIPTION_HTTP_IDLE_TIMEOUT=60s
SUBSCRIPTION_HTTP_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
SUBSCRIPTION_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/pricing?sslmode=disable
SUBSCRIPTION_POSTGRES_MAX_OPEN_CONNS=20
SUBSCRIPTION_POSTGRES_MAX_IDLE_CONNS=10
SUBSCRIPTION_POSTGRES_CONN_MAX_LIFETIME=30m
SUBSCRIPTION_POSTGRES_RUN_MIGRATIONS=true

# Redis
SUBSCRIPTION_REDIS_ADDR=localhost:6379
SUBSCRIPTION_REDIS_USERNAME=
SUBSCRIPTION_REDIS_PASSWORD=
SUBSCRIPTION_REDIS_DB=0
SUBSCRIPTION_REDIS_NAMESPACE=subscription

# NATS
SUBSCRIPTION_NATS_URL=nats://127.0.0.1:4222
SUBSCRIPTION_NATS_STREAM=subscription

# Auth Service SSO (JWT)
SUBSCRIPTION_REQUIRE_JWT=true
SUBSCRIPTION_JWT_JWKS_URL=https://sso.codevertexafrica.com/api/v1/.well-known/jwks.json
SUBSCRIPTION_JWT_ISSUER=https://sso.codevertexafrica.com
SUBSCRIPTION_JWT_AUDIENCE=codevertex

# Optional: API Key fallback (for development)
SUBSCRIPTION_API_KEY=
SUBSCRIPTION_API_KEY_DB_URL=

# OpenTelemetry (optional)
SUBSCRIPTION_OTLP_ENDPOINT=

